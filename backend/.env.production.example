# Lingkungan aplikasi
APP_ENV=production

# Konfigurasi Database Supabase (Connection Pooler sangat disarankan, port 6543)
DB_HOST=your-supabase-pooler-host.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.your-project-id
DB_PASSWORD=your-database-password
DB_NAME=postgres
DB_SSLMODE=require

# Secret untuk enkripsi JWT Token
JWT_SECRET=your-jwt-secret-key-at-least-32-chars

# Masa berlaku JWT Token
JWT_ACCESS_EXPIRY_HOURS=8
JWT_REFRESH_EXPIRY_DAYS=7

# Konfigurasi Midtrans Integration
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_ENV=sandbox

# Domain Frontend Vercel (untuk konfigurasi CORS)
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app
